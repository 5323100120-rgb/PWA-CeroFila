<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FilaCero.Mobile.Pages.HomePage" Title="Inicio">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="CONSULTORIOS SIMILARES" Style="{StaticResource Eyebrow}" CharacterSpacing="1.2" />
                    <Label Text="FilaCero" Style="{StaticResource BigTitle}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" BackgroundColor="{StaticResource Mint}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="12,6" VerticalOptions="Center">
                    <Label x:Name="ConnectionLabel" Text="● EN LÍNEA" TextColor="{StaticResource Deep}" FontSize="11" FontAttributes="Bold" />
                </Border>
            </Grid>

            <Border StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#097F78" Offset="0.0" />
                        <GradientStop Color="#008C81" Offset="0.58" />
                        <GradientStop Color="#23AAA0" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="8">
                    <Label Text="TU TURNO SIN HACER FILA" TextColor="#BDF5DC" FontAttributes="Bold" FontSize="11" CharacterSpacing="1" />
                    <Label x:Name="MainTicketLabel" Text="Tu atención empieza aquí" TextColor="White" FontSize="24" FontAttributes="Bold" />
                    <Label x:Name="HeroStatus" Text="Ubica tu consultorio más cercano, realiza tu pre-triaje y obtén tu pase QR." TextColor="#E6FBF6" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 18" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Pasos para tu consulta" FontAttributes="Bold" FontSize="17" />
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                    <Label x:Name="Step1" Text="1. Pre-registro y consultorio: pendiente" FontSize="14" />
                    <Label x:Name="Step2" Text="2. Pre-triaje de síntomas: pendiente" FontSize="14" />
                    <Label x:Name="Step3" Text="3. Pase QR digital: pendiente" FontSize="14" />
                    <Label x:Name="NoticeLabel" Text="Listo para iniciar tu solicitud." Style="{StaticResource SubText}" Margin="0,4,0,0" />
                    <Button Text="Buscar consultorio y registrarme" Clicked="OpenRegister" Margin="0,6,0,0" />
                    <Button Text="Ver mi pase QR" Style="{StaticResource OutlineButton}" Clicked="OpenTicket" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>